
config carbridge 'main'
	option enabled '1'
	# the name the iPhone and the head unit show
	option name 'CarBridge'
	# the Bluetooth adapter, for the head unit (LE) and the iPhone (Classic)
	option adapter 'hci0'
	# the MAC address of the Wi-Fi adapter that joins the head unit's network, as chosen in the web interface:
	# CarBridge leaves that adapter out of OpenWrt's Wi-Fi and names its interface carlink0
	#option carlink_mac ''
	# without carlink_mac, the Wi-Fi interface that joins the head unit's network, as it is named; it must not be one
	# the router's own Wi-Fi uses
	option carlink_iface 'carlink0'
	# the router's access point the iPhone joins for CarPlay, and the network it belongs to
	option ap_iface 'wlan0'
	option lan_iface 'br-lan'
	option carplay '1'
	# The picture, frame rate, start and H.265 options below are the defaults for head units without settings of
	# their own; a head unit's own settings are kept with its key and set in the web interface.
	# the size of the picture the iPhone renders: 'auto' is the area the head unit shows the cast in, from its
	# configuration, kept for the next start; 'fixed' is carplay_size
	option carplay_picture 'auto'
	# the fixed picture size in pixels, also used with 'auto' until a head unit is known
	option carplay_size '1280x720'
	# CarPlay's frame rate: 'auto' is the head unit's (30 when it asks for 30), or '30' to '60'
	option carplay_fps 'auto'
	# how the cast shows when a head unit with window modes connects: 'fullscreen', or 'window', the head unit's
	# window, landscape in its mirror mode and portrait in its simple mode; its window button switches between the two
	option carplay_start 'fullscreen'
	# H.265 to the head unit: 'off' casts H.264; 'auto' casts H.265 to head units that offer it; 'force' has the
	# iPhone send H.265 and the head unit decode it, even when the head unit does not offer H.265
	option hevc 'auto'
	# the kind of sound the iPhone's navigation prompts play as on the head unit, which treats them as such (their
	# volume, how other sound is lowered, audio focus): 'tts' (navigation speech), 'media', 'call' or 'assistant'
	option nav_audio 'tts'
	# seconds iPhones can pair after CarBridge starts; 0 for only on request
	option pairing_window '0'
	# a detailed log, with diagnostics of the microphone, the sound and the link to the head unit, written to
	# detail_log_dir on persistent storage: 10 MiB at most, the oldest lines removed first; it follows this option
	# without a restart
	option detail_log '0'
	option detail_log_dir '/opt/carbridge/log'
